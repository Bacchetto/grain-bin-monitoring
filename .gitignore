# ---------------------------------------------------------------------------
# Secrets and local state -- never commit these.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
# Written by `sim.py --seed-bins`; contains plaintext device API keys.
simulator/.devices.json

# ---------------------------------------------------------------------------
# Java / Maven
# ---------------------------------------------------------------------------
target/
hs_err_pid*
replay_pid*
# Note: *.jar is deliberately NOT ignored. All real build output lives in
# target/, which is covered above. This wrapper is configured as
# distributionType=only-script, so it downloads Maven itself and no
# maven-wrapper.jar is committed -- but blanket-ignoring *.jar is the kind of
# rule that silently breaks ./mvnw on a clean checkout if that ever changes.

# ---------------------------------------------------------------------------
# Node / Vite (frontend, Milestone 2)
# ---------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
npm-debug.log*
yarn-error.log*

# ---------------------------------------------------------------------------
# Python (simulator)
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.egg-info/

# ---------------------------------------------------------------------------
# Terraform (Milestone 3)
# ---------------------------------------------------------------------------
.terraform/
*.tfstate
*.tfstate.*
crash.log
# Saved plans (terraform plan -out). They hold every value the apply will
# set, in readable form -- including generated secrets such as ADMIN_TOKEN.
*.tfplan
*.tfvars
!*.tfvars.example
# Note: .terraform.lock.hcl IS committed -- it pins provider versions so CI
# and local runs resolve identically.

# ---------------------------------------------------------------------------
# Local observability data (Milestone 2)
# ---------------------------------------------------------------------------
ops/grafana/data/
ops/prometheus/data/

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.idea/
*.iml
.vscode/
*.swp
.DS_Store
Thumbs.db
