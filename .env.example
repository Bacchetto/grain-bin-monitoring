# Copy to .env and fill in real values. .env is git-ignored -- never commit it.
#
#   cp .env.example .env
#
# The API reads all configuration from environment variables so that the same
# image runs locally and in AWS, where these come from Secrets Manager instead.

# --- Database -------------------------------------------------------------
# Matches the Postgres service in docker-compose.yml.
# Do not add ?reWriteBatchedInserts=true -- it breaks duplicate counting on
# ingest. See the comment beside spring.datasource.url in application.properties.
DB_URL=jdbc:postgresql://localhost:5432/grain
DB_USER=grain
DB_PASSWORD=change-me-locally

# --- Admin API ------------------------------------------------------------
# Bearer token for the admin and dashboard endpoints under /api/v1.
# This is deliberately simple and is NOT production-grade auth; the tradeoff
# is recorded in docs/decisions/.
#
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=change-me-locally

# --- CORS -----------------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser.
# 5173 is the Vite dev server (frontend arrives in Milestone 2).
# Exact origins only: a wildcard stops the API at startup. Empty allows no
# browser origin at all. Devices and curl are unaffected either way.
CORS_ALLOWED_ORIGINS=http://localhost:5173
