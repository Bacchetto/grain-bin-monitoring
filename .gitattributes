# Normalise line endings in the repository to LF.
# This machine has core.autocrlf=true, which would otherwise give shell
# scripts CRLF endings in the working tree. The Docker build copies from the
# working tree into a Linux image, where a CRLF shebang fails with
# "bad interpreter: No such file or directory" -- so the scripts below are
# pinned to LF explicitly rather than left to autocrlf.
* text=auto

# Must be LF: executed by /bin/sh inside Linux containers and CI runners.
mvnw           text eol=lf
*.sh           text eol=lf
.githooks/*    text eol=lf
Dockerfile     text eol=lf
*.Dockerfile   text eol=lf

# Must be CRLF: only ever run by Windows shells.
*.bat          text eol=crlf
*.cmd          text eol=crlf

# Never munge these.
*.jar          binary
*.png          binary
*.jpg          binary
*.ico          binary
