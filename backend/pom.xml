<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<!--
		The Spring Boot parent supplies a dependency-management section that pins
		a consistent, tested version for every Spring and third-party library
		below. That is why almost no <version> tags appear in this file.
	-->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/>
	</parent>

	<groupId>com.grainbin</groupId>
	<artifactId>telemetry</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>telemetry</name>
	<description>Grain bin telemetry ingest, query and alerting service</description>

	<properties>
		<java.version>21</java.version>
	</properties>

	<dependencies>
		<!--
			NOTE ON SPRING BOOT 4 NAMING: the starter formerly called
			spring-boot-starter-web is now spring-boot-starter-webmvc, and Flyway
			now needs its own explicit starter. Most tutorials online still show
			the Boot 3 names.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!-- Bean Validation, for @Valid on the ingest and admin request bodies. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!--
			JdbcClient / JdbcTemplate and a HikariCP connection pool.
			This project uses plain Spring JDBC rather than JPA; see the ADR.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc</artifactId>
		</dependency>

		<!-- Schema migrations. Runs automatically at startup. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<!--
			Flyway splits per-database support into separate modules. Without
			this, Flyway cannot handle Postgres-specific DDL such as the
			partitioned tables this schema relies on.
		-->
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>

		<!-- /actuator/health and /actuator/prometheus. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<!-- Renders Micrometer metrics in the Prometheus text format. -->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- JDBC driver. Only needed at runtime, never compiled against. -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!--
			TEST DEPENDENCIES
			Spring Boot 4 replaced the single spring-boot-starter-test with
			per-module test starters, so each slice is pulled in explicitly.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-jdbc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!--
			Testcontainers runs a real PostgreSQL in Docker for integration
			tests. The project rule is no H2 and no mocked database: the schema
			uses partitioning and ON CONFLICT, which an in-memory database
			cannot faithfully reproduce.

			spring-boot-testcontainers provides @ServiceConnection, which points
			the application's DataSource at the container automatically.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!--
				Repackages the jar as an executable, layered archive. The layers
				matter in Milestone 3: they let Docker cache dependency layers
				separately from application code.
			-->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<!--
						Activates the `local` profile for `./mvnw spring-boot:run`
						only, which makes the API read the repository's .env the
						same way Docker Compose does. See application-local.properties.

						This setting belongs to the run goal. It does not reach the
						tests, which must never depend on a developer's .env, nor
						the packaged jar, which is configured from real environment
						variables in production.
					-->
					<profiles>
						<profile>local</profile>
					</profiles>
				</configuration>
			</plugin>

			<!--
				The admin token is mandatory and has no default, so tests need
				one to start a context at all.

				It is supplied as an ENVIRONMENT VARIABLE rather than a
				src/test/resources/application.properties, on purpose. Spring
				Boot resolves classpath:/application.properties to a single
				resource, and a copy in the test tree shadows the real one
				entirely. The tests would then run against none of the
				application's actual configuration, and would happily pass
				while the packaged application was misconfigured.

				Injecting the variable instead means tests read the same
				application.properties that ships, through the same
				${ADMIN_TOKEN} indirection production uses.

				This value is not a secret and protects nothing.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<environmentVariables>
						<ADMIN_TOKEN>test-admin-token-do-not-use-anywhere-real</ADMIN_TOKEN>
					</environmentVariables>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
